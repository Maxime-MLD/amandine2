---
import { businessConfig } from "../../config/business.config";
import { contactConfig } from "../../config/contact.config";
import { navigationConfig } from "../../config/navigation.config";

interface Props { class?: string }
const { class: className } = Astro.props;
const { footer } = contactConfig;
const currentYear = new Date().getFullYear();
---

<footer class:list={["site-footer", className]}>
  <div class="footer-top">
    <nav aria-label={navigationConfig.labels.footerNavigation}>
      <h2>{footer.navigationTitle}</h2>
      <ul class="footer-links">
        {footer.links.map((link) => <li><a class="focus-ring" href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <h2>{footer.cabinetTitle}</h2>
      <address class="footer-links not-italic">
        <span>{contactConfig.street}<br />{contactConfig.city}</span>
        <span>{contactConfig.appointmentNote}</span>
        <a class="focus-ring" href={contactConfig.directionsHref} target="_blank" rel="noopener noreferrer">{contactConfig.directionsLabel}</a>
      </address>
    </div>
    <nav aria-label={navigationConfig.labels.legalNavigation}>
      <h2>{footer.legalTitle}</h2>
      <ul class="footer-links">
        {navigationConfig.legalItems.map((link) => <li><a class="focus-ring" href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
    <div class="footer-contact">
      <h2>{footer.contactTitle}</h2>
      <div class="footer-links">
        <a class="focus-ring" href={contactConfig.phoneHref}>{contactConfig.phone}</a>
        <a class="focus-ring" href={contactConfig.banner.href}>{footer.contactLabel}</a>
      </div>
    </div>
  </div>
  <p class="footer-signature">{businessConfig.tradeName}</p>
  <div class="footer-bottom">
    <p>© {currentYear} {businessConfig.tradeName}. {footer.copyright}</p>
    <p>{footer.creditPrefix} <a class="focus-ring" href={footer.studioHref} target="_blank" rel="noopener noreferrer">{footer.studioName}</a></p>
  </div>
</footer>

<style>
  .site-footer {
    padding: clamp(2rem, 4vw, 4rem) clamp(1.25rem, 6vw, 6rem) 2rem;
    border-radius: 0 0 var(--radius-xl) var(--radius-xl);
    background: var(--color-frame);
  }
  .footer-top { display: grid; gap: 2.5rem 2rem; }
  h2 { font-size: 0.875rem; font-weight: 500; }
  .footer-links { display: flex; flex-direction: column; gap: 0.875rem; list-style: none; padding: 0; margin-top: 1.5rem; font-size: 0.8125rem; line-height: 1.6; color: var(--color-text-secondary); }
  a { text-decoration: none; }
  a:hover { text-decoration: underline; }
  .footer-signature { margin-top: 3rem; text-align: center; font-size: clamp(2.1rem, 8.3vw, 8rem); line-height: 1.04; font-weight: 400; letter-spacing: -0.06em; }
  .footer-bottom { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 2.5rem; color: var(--color-text-secondary); font-size: 0.75rem; line-height: 1.6; }
  .footer-bottom a { color: var(--color-text); text-decoration: underline; text-underline-offset: 0.2em; }
  @media (min-width: 40rem) {
    .footer-top { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer-bottom { flex-direction: row; justify-content: space-between; }
  }
  @media (min-width: 64rem) {
    .footer-top { grid-template-columns: 1fr 1.2fr 1.3fr 1.3fr; }
    .footer-contact { justify-self: end; }
  }
</style>
