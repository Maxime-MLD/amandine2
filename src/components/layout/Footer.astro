---
import { businessConfig } from "../../config/business.config";
import { contactConfig } from "../../config/contact.config";
import { navigationConfig } from "../../config/navigation.config";

interface Props { class?: string }
const { class: className } = Astro.props;
const { footer } = contactConfig;
const currentYear = new Date().getFullYear();
---

<footer class:list={["site-footer", className]}>
  <div class="footer-main">
    <div class="footer-navigation">
      <nav aria-label={navigationConfig.labels.footerNavigation}>
        <h2>{footer.navigationTitle}</h2>
        <ul class="footer-links">
          {footer.links.map((link) => <li><a class="focus-ring" href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2>{footer.cabinetTitle}</h2>
        <address class="footer-links not-italic">
          <span>{contactConfig.street}<br />{contactConfig.city}</span>
          <span>{contactConfig.appointmentNote}</span>
          <a class="focus-ring" href={contactConfig.directionsHref} target="_blank" rel="noopener noreferrer">{contactConfig.directionsLabel}</a>
        </address>
      </div>
      <nav aria-label={navigationConfig.labels.legalNavigation}>
        <h2>{footer.legalTitle}</h2>
        <ul class="footer-links">
          {navigationConfig.legalItems.map((link) => <li><a class="focus-ring" href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="footer-brand">
      <div class="footer-contact">
        <h2>{footer.contactTitle}</h2>
        <div class="footer-links">
          <a class="focus-ring" href={contactConfig.phoneHref}>{contactConfig.phone}</a>
          <a class="focus-ring" href={contactConfig.banner.href}>{footer.contactLabel}</a>
        </div>
      </div>
      <p class="footer-signature" aria-label={businessConfig.tradeName}>
        <span aria-hidden="true">{businessConfig.owner.firstName}</span>
        <span aria-hidden="true">{businessConfig.owner.lastName}</span>
      </p>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© {currentYear} {businessConfig.tradeName}. {footer.copyright}</p>
    <p>{footer.creditPrefix} <a class="focus-ring" href={footer.studioHref} target="_blank" rel="noopener noreferrer">{footer.studioName}</a></p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-inline: var(--section-inline-margin);
    padding: calc(var(--section-inline-padding) + clamp(1.5rem, 2.5vw, 2rem)) var(--section-inline-padding) clamp(1.25rem, 1.5vw, 1.5rem);
    border-radius: 0 0 var(--radius-xl) var(--radius-xl);
    background: var(--color-frame);
  }
  .site-footer::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-border-strong) 12%,
      var(--color-border-strong) 88%,
      transparent
    );
    content: "";
    pointer-events: none;
  }
  .footer-main { display: grid; gap: clamp(3rem, 6vw, 6rem); }
  .footer-navigation { display: grid; gap: 2.5rem 2rem; }
  h2 {
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 400;
    opacity: 1;
  }
  .footer-links { display: flex; flex-direction: column; gap: 0.875rem; list-style: none; padding: 0; margin-top: 1.5rem; font-size: 0.8125rem; line-height: 1.6; color: var(--color-text-secondary); }
  a { text-decoration: none; }
  a:hover { text-decoration: underline; }
  .footer-brand { display: flex; min-width: 0; flex-direction: column; }
  .footer-signature {
    width: 100%;
    margin: clamp(2.75rem, 3.5vw, 3.5rem) 0 0;
    font-size: clamp(3.35rem, 12vw, 6rem);
    font-weight: 400;
    line-height: 0.82;
    letter-spacing: -0.07em;
  }
  .footer-signature span { display: block; }
  .footer-signature span:last-child { margin-left: 0.35em; }
  .footer-bottom { display: flex; flex-direction: column; gap: 0.75rem; margin-top: clamp(2.75rem, 3.25vw, 3.5rem); color: var(--color-text-secondary); font-size: 0.75rem; line-height: 1.6; }
  .footer-bottom a { color: var(--color-text); text-decoration: underline; text-underline-offset: 0.2em; }
  @media (min-width: 40rem) {
    .footer-navigation { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .footer-bottom { flex-direction: row; justify-content: space-between; }
  }
  @media (min-width: 64rem) {
    .footer-main {
      grid-template-columns: repeat(4, minmax(9rem, 12rem));
      justify-content: center;
      column-gap: clamp(1.5rem, 3vw, 3rem);
      row-gap: clamp(2.75rem, 3.5vw, 3.5rem);
      align-items: start;
    }
    .footer-navigation { display: contents; }
    .footer-brand { display: contents; }
    .footer-contact { grid-column: 4; grid-row: 1; }
    .footer-signature {
      grid-column: 3 / 5;
      grid-row: 2;
      justify-self: end;
      width: auto;
      margin: 0;
      font-size: clamp(3.75rem, 4vw, 4.75rem);
      text-align: right;
    }
  }
</style>
