---
import { businessConfig } from "../../config/business.config";
import { navigationConfig } from "../../config/navigation.config";
import { isNavigationItemActive } from "../../utils/navigation";
import ArrowIcon from "../ui/ArrowIcon.astro";

export interface Props {
  dialogId?: string;
}

const { dialogId = "mobile-navigation" } = Astro.props as Props;
const currentPathname = Astro.url.pathname;
const dialogTitleId = `${dialogId}-title`;
const navigationItems = navigationConfig.items;
---

<div class="lg:hidden" data-mobile-menu>
  <button
    type="button"
    class="focus-ring tap-target inline-flex items-center justify-center rounded-[var(--radius-md)] lg:hidden"
    aria-label={navigationConfig.labels.openMenu}
    aria-controls={dialogId}
    aria-expanded="false"
    aria-haspopup="dialog"
    data-mobile-menu-open
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      class="size-6"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
    >
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
  </button>

  <dialog
    id={dialogId}
    class="mobile-dialog m-0 ml-auto h-dvh max-h-dvh w-[min(90vw,24rem)] max-w-none border-0 bg-[var(--color-surface)] p-0 text-[var(--color-text)]"
    aria-labelledby={dialogTitleId}
    data-mobile-menu-dialog
  >
    <div class="mobile-drawer">
      <div class="mobile-header flex min-h-20 items-center justify-between gap-4 px-[var(--page-padding)]">
        <a
          href="/"
          id={dialogTitleId}
          class="safe-wrap font-medium tracking-[-0.035em] no-underline"
          data-mobile-menu-link
        >
          {businessConfig.tradeName}
        </a>
        <button
          type="button"
          class="focus-ring tap-target inline-flex items-center justify-center rounded-[var(--radius-md)]"
          aria-label={navigationConfig.labels.closeMenu}
          data-mobile-menu-close
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="size-6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
          >
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>

      <div class="mobile-content">
        <p class="menu-eyebrow">{navigationConfig.mobileMenu.eyebrow}</p>

        <nav aria-label={navigationConfig.labels.mobileNavigation}>
          <ul class="mobile-navigation-list">
            {
              navigationItems.map((item) => (
                <li class="mobile-navigation-item menu-reveal">
                  <a
                    href={item.href}
                    class="menu-link focus-ring safe-wrap"
                    aria-label={item.ariaLabel}
                    aria-current={
                      isNavigationItemActive(currentPathname, item.href, item.external)
                        ? "page"
                        : undefined
                    }
                    target={item.external ? "_blank" : undefined}
                    rel={item.external ? "noopener noreferrer" : undefined}
                    data-mobile-menu-link
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="mobile-actions menu-reveal">
          <a
            href={navigationConfig.appointment.href}
            class="mobile-cta btn-primary focus-ring w-full"
            aria-label={navigationConfig.appointment.ariaLabel}
            data-mobile-menu-link
          >
            <span>{navigationConfig.appointment.label}</span>
            <span aria-hidden="true"><ArrowIcon /></span>
          </a>
          <p class="mobile-meta">{navigationConfig.mobileMenu.meta}</p>
        </div>
      </div>
    </div>
  </dialog>
</div>

<style>
  .mobile-dialog {
    font-family: var(--font-primary);
    opacity: 0;
    transform: translateX(100%);
    transition:
      transform var(--duration-normal) var(--ease-premium),
      opacity var(--duration-normal) var(--ease-premium);
  }

  .mobile-dialog[open] {
    opacity: 1;
    transform: translateX(0);
  }

  .mobile-dialog::backdrop {
    background: var(--color-overlay);
    opacity: 0;
    transition: opacity var(--duration-normal) ease-out;
  }

  .mobile-dialog[open]::backdrop { opacity: 1; }

  @starting-style {
    .mobile-dialog[open] {
      opacity: 0;
      transform: translateX(100%);
    }

    .mobile-dialog[open]::backdrop { opacity: 0; }
  }

  .mobile-drawer {
    min-height: 100%;
    overflow-y: auto;
  }

  .mobile-header {
    position: sticky;
    z-index: 2;
    top: 0;
    background: var(--color-surface);
  }

  .mobile-content {
    padding: clamp(2rem, 7vh, 4rem) var(--page-padding) 3rem;
  }

  .menu-eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-text-secondary);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .mobile-navigation-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-navigation-item {
    border-bottom: 1px solid var(--color-border);
    transition: border-color 275ms ease-out;
  }

  .menu-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 0.375rem;
    align-items: center;
    gap: 1rem;
    padding: 1.05rem 0;
    color: var(--color-text);
    font-size: clamp(1.6rem, 6vw, 2rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.12;
    text-decoration: none;
    transition:
      color 275ms ease-out,
      transform 275ms ease-out;
  }

  .menu-link::after {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--color-journey-lilac);
    content: "";
    opacity: 0;
    transform: scale(0.75);
    transition:
      opacity 275ms ease-out,
      transform 275ms ease-out;
  }

  .menu-link[aria-current="page"]::after {
    opacity: 1;
    transform: scale(1);
  }

  .mobile-actions { margin-top: clamp(2.25rem, 7vh, 3.5rem); }

  .mobile-cta {
    justify-content: space-between;
    gap: 1.5rem;
  }

  .mobile-meta {
    margin: 1rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .mobile-dialog[open] .menu-reveal {
    animation: menu-reveal 400ms var(--ease-premium) both;
  }

  .mobile-dialog[open] .mobile-navigation-item:nth-child(2) { animation-delay: 40ms; }
  .mobile-dialog[open] .mobile-navigation-item:nth-child(3) { animation-delay: 80ms; }
  .mobile-dialog[open] .mobile-actions { animation-delay: 120ms; }

  @keyframes menu-reveal {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (hover: hover) and (pointer: fine) {
    .mobile-navigation-item:hover { border-color: var(--color-border-strong); }
    .menu-link:hover { transform: translateX(4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-dialog,
    .mobile-dialog::backdrop,
    .menu-link,
    .mobile-navigation-item {
      transition-duration: 0.01ms;
    }

    .mobile-dialog[open] .menu-reveal { animation: none; }
  }
</style>

<script>
  function initializeMobileMenus() {
    const menuRoots = document.querySelectorAll<HTMLElement>("[data-mobile-menu]");

    menuRoots.forEach((menuRoot) => {
      if (menuRoot.dataset.initialized === "true") {
        return;
      }

      const openButton = menuRoot.querySelector<HTMLButtonElement>("[data-mobile-menu-open]");
      const closeButton = menuRoot.querySelector<HTMLButtonElement>("[data-mobile-menu-close]");
      const dialog = menuRoot.querySelector<HTMLDialogElement>("[data-mobile-menu-dialog]");

      if (!openButton || !closeButton || !dialog) {
        return;
      }

      let previousRootOverflow = "";

      const closeMenu = () => {
        if (dialog.open) {
          dialog.close();
        }
      };

      openButton.addEventListener("click", () => {
        previousRootOverflow = document.documentElement.style.overflow;
        document.documentElement.style.overflow = "hidden";
        dialog.showModal();
        openButton.setAttribute("aria-expanded", "true");
        closeButton.focus();
      });

      closeButton.addEventListener("click", closeMenu);

      dialog.addEventListener("click", (event) => {
        const target = event.target;
        const clickedMenuLink =
          target instanceof Element && target.closest("[data-mobile-menu-link]");

        if (target === dialog || clickedMenuLink) {
          closeMenu();
        }
      });

      dialog.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          closeMenu();
        }
      });

      dialog.addEventListener("close", () => {
        document.documentElement.style.overflow = previousRootOverflow;
        openButton.setAttribute("aria-expanded", "false");
        openButton.focus({ preventScroll: true });
      });

      menuRoot.dataset.initialized = "true";
    });
  }

  initializeMobileMenus();
</script>
