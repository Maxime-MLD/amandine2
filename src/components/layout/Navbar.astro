---
import { businessConfig } from "../../config/business.config";
import { navigationConfig } from "../../config/navigation.config";
import { isNavigationItemActive } from "../../utils/navigation";
import MobileMenu from "./MobileMenu.astro";

type NavbarVariant = "default" | "transparent" | "light" | "dark";

export interface Props {
  variant?: NavbarVariant;
  sticky?: boolean;
  hideOnScroll?: boolean;
  class?: string;
}

const {
  variant = "light",
  sticky = false,
  hideOnScroll = false,
  class: className,
} = Astro.props as Props;

const variantClasses: Record<NavbarVariant, string> = {
  default: "bg-[var(--color-frame)] text-[var(--color-text)]",
  light: "bg-[var(--color-frame)] text-[var(--color-text)]",
  transparent: "bg-transparent text-[var(--color-text)]",
  dark: "bg-[var(--color-dark)] text-[var(--color-surface)]",
};
const { appointment } = navigationConfig;
---

<header
  class:list={["site-navbar z-50 w-full", sticky ? "sticky top-0" : "relative", variantClasses[variant], className]}
  data-navbar
  data-navbar-sticky={sticky ? "true" : "false"}
  data-navbar-variant={variant}
  data-hide-on-scroll={hideOnScroll ? "true" : "false"}
>
  <div class="navbar-inner">
    <a href="/" class="brand focus-ring min-w-0 no-underline">
      <span class="block text-[1.0625rem] font-semibold tracking-[-0.04em] sm:text-[1.375rem]">
        {businessConfig.tradeName}
      </span>
    </a>

    <nav class="hidden lg:block" aria-label={navigationConfig.labels.primaryNavigation}>
      <ul class="m-0 flex list-none items-center gap-6 p-0 xl:gap-9">
        {navigationConfig.items.map((item) => (
          <li>
            <a
              class="focus-ring inline-flex min-h-11 items-center rounded-[var(--radius-pill)] text-[0.8125rem] font-normal no-underline underline-offset-4 hover:underline"
              href={item.href}
              aria-label={item.ariaLabel}
              aria-current={isNavigationItemActive(Astro.url.pathname, item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center justify-end gap-3">
      <a class="btn-primary focus-ring hidden min-h-12 text-[0.8125rem] sm:inline-flex" href={appointment.href} aria-label={appointment.ariaLabel}>
        {appointment.label}
      </a>
      <MobileMenu />
    </div>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLElement>('[data-navbar-sticky="true"]').forEach((navbar) => {
    if (navbar.dataset.stickyInitialized === "true") return;

    const scrolledThreshold = 96;
    let frameRequested = false;

    const updateScrolledState = () => {
      navbar.classList.toggle("is-scrolled", window.scrollY > scrolledThreshold);
      frameRequested = false;
    };

    const handleScroll = () => {
      if (frameRequested) return;
      frameRequested = true;
      window.requestAnimationFrame(updateScrolledState);
    };

    updateScrolledState();
    window.addEventListener("scroll", handleScroll, { passive: true });
    window.addEventListener("pageshow", updateScrolledState);
    navbar.dataset.stickyInitialized = "true";
  });
</script>

<style>
  .site-navbar {
    isolation: isolate;
    transition:
      background-color 300ms ease-out,
      border-color 300ms ease-out,
      backdrop-filter 300ms ease-out,
      -webkit-backdrop-filter 300ms ease-out;
  }

  .site-navbar::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background-color: transparent;
    content: "";
    transition: background-color 300ms ease-out;
    pointer-events: none;
  }

  .site-navbar.is-scrolled {
    background-color: rgb(249 249 249 / 0.88);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .site-navbar.is-scrolled::after {
    background-color: var(--color-border);
  }

  @supports not ((-webkit-backdrop-filter: blur(12px)) or (backdrop-filter: blur(12px))) {
    .site-navbar.is-scrolled { background-color: rgb(249 249 249 / 0.97); }
  }

  .navbar-inner {
    display: flex;
    min-height: var(--navbar-height);
    max-width: var(--container);
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-inline: auto;
    padding: 0.75rem clamp(0.75rem, 2.2vw, 2.5rem);
  }

  @media (min-width: 64rem) {
    .navbar-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: clamp(1rem, 2vw, 2rem);
    }
  }
</style>
