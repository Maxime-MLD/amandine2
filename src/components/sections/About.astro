---
import { homeConfig } from "../../config/home.config";
import ResponsiveImage from "../ui/ResponsiveImage.astro";

const { about } = homeConfig;
---

<section id="about" class="about-section" aria-labelledby="about-title">
  <div class="about-card">
    <div class="about-visual">
      <div class="about-lights" aria-hidden="true">
        <span class="light light-top"></span>
        <span class="light light-left"></span>
        <span class="light light-bottom"></span>
      </div>
      <div class="about-portrait">
        <ResponsiveImage
          src={about.image.src}
          alt={about.image.alt}
          widths={[360, 540, 720, 960]}
          sizes="(min-width: 2048px) 760px, (min-width: 768px) 40vw, 85vw"
          formats={["webp"]}
          fallbackFormat="webp"
          width={about.image.src.width}
          height={about.image.src.height}
          quality={85}
          pictureClass="about-picture"
          class="h-full! w-full object-contain object-bottom"
        />
      </div>
    </div>

    <div class="about-copy min-w-0">
      <h2 id="about-title" class="font-normal">{about.title}</h2>
      <p class="mt-6 text-lg leading-snug text-[var(--color-text-secondary)] md:text-xl xl:text-2xl">{about.subtitle}</p>
      <p class="about-description mt-4 max-w-[30rem] leading-relaxed text-[var(--color-text-secondary)]">
        {about.description.map((part) => "emphasis" in part && part.emphasis
          ? <span class="about-description-emphasis">{part.text}</span>
          : part.text)}
      </p>
    </div>
  </div>
</section>

<style>
  .about-section {
    margin-inline: var(--section-inline-margin);
    /* Même respiration entre les sections, à l'intérieur du cadre blanc continu. */
    padding-bottom: var(--section-gap);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    background: var(--color-surface);
  }

  .about-card {
    display: grid;
    width: 100%;
    max-width: 72rem;
    gap: 2rem;
    overflow: hidden;
    margin-inline: auto;
    padding: 1.25rem var(--section-inline-padding) 2.5rem;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    background: var(--color-surface);
  }

  .about-visual {
    position: relative;
    isolation: isolate;
    min-width: 0;
    height: clamp(20rem, 75vw, 30rem);
    overflow: hidden;
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 26rem;
    justify-self: center;
    background: linear-gradient(
      180deg,
      var(--color-blue-soft),
      var(--color-lilac-soft) 40%,
      var(--color-pink-soft) 74%,
      var(--color-peach-soft)
    );
  }

  .about-portrait {
    position: relative;
    z-index: 1;
    width: 100%;
    height: calc(100% - 1.75rem);
    margin: 1.75rem auto 0;
  }

  .about-portrait :global(.about-picture) { display: block; height: 100%; }

  .about-lights { position: absolute; inset: 0; pointer-events: none; }
  .light {
    position: absolute;
    aspect-ratio: 1;
    border: 1px solid var(--color-hero-orb-edge);
    border-radius: var(--radius-pill);
    background: var(--color-hero-orb);
  }
  .light-top { width: 42%; top: 10%; left: 8%; }
  .light-left { width: 58%; top: 43%; left: -24%; }
  .light-bottom { width: 76%; right: -22%; bottom: -32%; }

  .about-copy {
    width: min(100%, 32rem);
    align-self: center;
    justify-self: center;
    padding-inline: 0.25rem;
    container-type: inline-size;
  }
  .about-description { font-size: clamp(1.0625rem, 1.2vw, 1.25rem); }
  .about-description-emphasis {
    color: color-mix(in srgb, var(--color-text) 78%, var(--color-text-secondary));
  }
  .about-copy h2 {
    font-size: clamp(1.5rem, 10.8cqi, 3rem);
    white-space: nowrap;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  @media (min-width: 48rem) {
    .about-copy h2 { font-size: clamp(1.5rem, 10.8cqi, 4.75rem); }
    .about-card {
      grid-template-columns: minmax(16rem, 26rem) minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 5rem);
      padding-block: clamp(3rem, 5vw, 5rem);
    }
    .about-visual {
      height: clamp(25rem, 40vw, 34rem);
    }
  }
</style>
