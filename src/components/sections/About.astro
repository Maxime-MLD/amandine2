---
import { homeConfig } from "../../config/home.config";
import ResponsiveImage from "../ui/ResponsiveImage.astro";

const { about } = homeConfig;
---

<section id="about" class="about-section" aria-labelledby="about-title">
  <div class="about-card">
    <div class="about-visual">
      <div class="about-lights" aria-hidden="true">
        <span class="light light-top"></span>
        <span class="light light-left"></span>
        <span class="light light-bottom"></span>
      </div>
      <div class="about-portrait">
        <ResponsiveImage
          src={about.image.src}
          alt={about.image.alt}
          widths={[360, 540, 720, 960]}
          sizes="(min-width: 1440px) 480px, (min-width: 768px) 40vw, 85vw"
          formats={["webp"]}
          fallbackFormat="webp"
          width={about.image.src.width}
          height={about.image.src.height}
          quality={85}
          class="w-full"
        />
      </div>
    </div>

    <div class="about-copy min-w-0">
      <h2 id="about-title" class="font-normal">{about.title}</h2>
      <p class="mt-6 text-lg leading-snug text-[var(--color-text-secondary)] md:text-xl xl:text-2xl">{about.subtitle}</p>
      <p class="mt-2 max-w-[22rem] text-sm leading-relaxed text-[var(--color-text-secondary)] md:text-base">{about.location}</p>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 0 clamp(0.5rem, 3vw, 3rem) clamp(4rem, 8vw, 8rem);
  }

  .about-card {
    display: grid;
    gap: 2rem;
    overflow: hidden;
    padding: 1.25rem 1.25rem 2.5rem;
    border-radius: var(--radius-xl);
    background: var(--color-surface);
  }

  .about-visual {
    position: relative;
    isolation: isolate;
    min-width: 0;
    height: clamp(20rem, 75vw, 30rem);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--gradient-hero);
  }

  .about-portrait {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 31rem;
    margin: 1.75rem auto 0;
  }

  .about-lights { position: absolute; inset: 0; pointer-events: none; }
  .light {
    position: absolute;
    aspect-ratio: 1;
    border: 1px solid var(--color-hero-orb-edge);
    border-radius: var(--radius-pill);
    background: var(--color-hero-orb);
  }
  .light-top { width: 48%; top: 5%; right: -12%; }
  .light-left { width: 38%; top: 48%; left: -10%; }
  .light-bottom { width: 85%; right: -15%; bottom: -28%; }

  .about-copy { align-self: center; padding-inline: 0.25rem; }
  .about-copy h2 {
    max-width: 8ch;
    font-size: clamp(2.5rem, 5vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  @media (min-width: 48rem) {
    .about-card {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 5rem);
      padding: clamp(3rem, 5vw, 5rem) clamp(2rem, 5vw, 5rem);
    }
    .about-visual {
      height: clamp(25rem, 40vw, 34rem);
    }
  }
</style>
