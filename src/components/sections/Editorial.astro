---
import { homeConfig } from "../../config/home.config";
import ResponsiveImage from "../ui/ResponsiveImage.astro";

const { message, lines, images } = homeConfig.editorial;
---

<section id="a-votre-ecoute" class="editorial" aria-labelledby="editorial-message" data-editorial>
  <div class="editorial-panel" data-editorial-panel>
    <h2 id="editorial-message" class="editorial-message" aria-label={message}>
      <span class="editorial-lines" aria-hidden="true">
        {lines.map((line, lineIndex) => {
          const lineWords = line.split(/\s+/);
          return (
            <span class="editorial-line">
              {lineWords.map((word, wordIndex) => (
                <Fragment>
                  <span
                    class="editorial-word"
                    data-editorial-word
                    data-editorial-lead={lineIndex === 0 && wordIndex === 0 ? "" : undefined}
                    data-motion
                  >{word}</span>{wordIndex < lineWords.length - 1 ? " " : ""}
                </Fragment>
              ))}
            </span>
          );
        })}
      </span>
    </h2>
    <figure class="editorial-gallery">
      <div class="editorial-images">
        {images.map((image) => image.kind === "mosaic" ? (
          <div class="editorial-mosaic" role="group" aria-label={image.label}>
            {image.items.map((item) => (
              <div class="editorial-mini-circle">
                <ResponsiveImage
                  src={item.src}
                  alt={item.alt}
                  width={item.src.width}
                  height={item.src.height}
                  widths={[120, 180, 240, 320, 480]}
                  sizes="(min-width: 2048px) 215px, (min-width: 768px) 11vw, 21vw"
                  formats={["webp"]}
                  fallbackFormat="webp"
                  quality={84}
                  class="w-full"
                />
              </div>
            ))}
          </div>
        ) : (
          <div class:list={["editorial-circle", { "editorial-circle--show-left-edge": image === images[1] }]}>
            <ResponsiveImage
              src={image.src}
              alt={image.alt}
              width={image.src.width}
              height={image.src.height}
              widths={[180, 320, 480, 640, 800]}
              sizes="(min-width: 2048px) 450px, (min-width: 768px) 23vw, 45vw"
              formats={["webp"]}
              fallbackFormat="webp"
              quality={85}
              class="w-full"
            />
          </div>
        ))}
      </div>
    </figure>
  </div>
</section>

<style>
  .editorial { position: relative; margin-block: var(--section-gap); }
  .editorial-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2rem, 4vw, 3.75rem);
    align-items: stretch;
  }
  .editorial-message {
    width: calc(100% - (var(--content-axis) * 2));
    max-width: 72rem;
    margin-inline: var(--content-axis) auto;
    color: var(--color-text);
    font-family: var(--font-primary);
    font-size: var(--font-size-editorial);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .editorial-lines, .editorial-line { display: block; }
  .editorial-word { display: inline-block; }
  .editorial-gallery { width: 100%; margin: 0; }
  .editorial-images { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(0.75rem, 1.2vw, 1.25rem); }
  .editorial-circle { aspect-ratio: 1; overflow: hidden; border-radius: var(--radius-pill); background: var(--color-surface); }
  .editorial-mosaic {
    aspect-ratio: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.4rem, 0.8vw, 0.8rem);
  }
  .editorial-mini-circle { aspect-ratio: 1; overflow: hidden; border-radius: var(--radius-pill); background: var(--color-surface); }
  .editorial-circle :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .editorial-circle :global(picture) { display: block; height: 100%; }
  .editorial-circle--show-left-edge :global(img) { object-position: left center; }
  .editorial-mini-circle :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .editorial-mini-circle :global(picture) { display: block; height: 100%; }

  @media (min-width: 48rem) {
    .editorial-images { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  @media (min-width: 64rem) {
    .editorial-line { white-space: nowrap; }
  }

  @media (prefers-reduced-motion: reduce), (forced-colors: active) {
    .editorial-word { opacity: 1 !important; }
  }
</style>

<script>
  import { animationConfig } from "../../config/animation.config";
  import { initMotion } from "../../scripts/motion";

  document.querySelectorAll<HTMLElement>("[data-editorial]").forEach((section) => {
    initMotion(`editorial-${section.id}`, ({ gsap, select }) => {
      const words = select<HTMLElement>("[data-editorial-word]");
      const message = section.querySelector<HTMLElement>("[data-editorial-panel] h2");
      const leadWord = section.querySelector<HTMLElement>("[data-editorial-lead]");
      if (!message || !leadWord || words.length < 2) return;

      const animatedWords = words.filter((word) => word !== leadWord);
      gsap.set(animatedWords, { opacity: animationConfig.editorial.mutedOpacity });
      gsap.set(leadWord, { opacity: 1 });
      gsap.to(animatedWords, {
        opacity: 1,
        duration: animationConfig.editorial.wordDuration,
        stagger: animationConfig.editorial.wordStagger,
        ease: "none",
        scrollTrigger: {
          trigger: message,
          start: "top 70%",
          end: "bottom 30%",
          scrub: true,
          invalidateOnRefresh: true,
        },
      });
    }, { scope: section });
  });
</script>
