---
import { careJourney } from "../../data/careJourney";
import CareJourneyCard from "../cards/CareJourneyCard.astro";
---

<section id="prise-en-charge" class="care-journey" aria-labelledby="journey-title" data-care-journey>
  <div class="journey-panel" data-journey-panel>
    <header class="journey-heading relative z-10 mx-auto text-center">
      <h2 id="journey-title" class="font-normal">
        {careJourney.title}<br />{careJourney.titleSecondLine}
      </h2>
      <p class="mx-auto mt-5 max-w-[29rem] text-sm leading-relaxed text-[var(--color-text-secondary)] sm:text-base">
        {careJourney.description}
      </p>
    </header>

    <ol class="journey-stage" data-journey-stage>
      {careJourney.steps.map((step) => (
        <li class="journey-step" data-journey-step data-motion>
          <CareJourneyCard step={step} />
        </li>
      ))}
    </ol>

    <div class="journey-action relative z-10 text-center" data-journey-action data-motion>
      <a href={careJourney.contact.href} aria-label={careJourney.contact.ariaLabel} class="btn-primary focus-ring">
        {careJourney.contact.label}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .care-journey {
    position: relative;
    margin-inline: clamp(0.5rem, 3vw, 3rem);
    margin-bottom: clamp(4rem, 8vw, 8rem);
  }
  .journey-panel {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: clamp(2.5rem, 5vh, 4rem) clamp(1rem, 3vw, 3rem) 2rem;
    border-radius: var(--radius-xl);
    background: var(--color-surface);
  }
  .journey-heading h2 {
    font-size: clamp(1.875rem, 4.2vw, 3.875rem);
    line-height: 1.06;
    letter-spacing: -0.045em;
  }
  .journey-stage {
    display: grid;
    gap: 1rem;
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .journey-step { min-width: 0; }
  .journey-action a { gap: 1.25rem; }

  @media (min-width: 64rem) {
    .journey-stage { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* Sans JS, mouvement réduit ou écran peu haut : les trois étapes restent en lecture normale. */
  @media (prefers-reduced-motion: no-preference) and (min-height: 800px) and (min-width: 375px) {
    .care-journey[data-journey-ready] { height: calc(100svh + var(--journey-scroll-space)); }
    :is([data-journey-ready], [data-journey-complete]) .journey-panel {
      position: sticky;
      top: 1rem;
      height: calc(100svh - 2rem);
      max-height: 64rem;
      overflow: clip;
      gap: 1.5rem;
    }
    :is([data-journey-ready], [data-journey-complete]) .journey-stage { position: relative; flex: 1; min-height: 0; max-width: 28rem; display: block; }
    :is([data-journey-ready], [data-journey-complete]) .journey-step { position: absolute; width: 90%; height: 15rem; }
    :is([data-journey-ready], [data-journey-complete]) .journey-step:nth-child(1) { left: 0; top: 0; z-index: 1; }
    :is([data-journey-ready], [data-journey-complete]) .journey-step:nth-child(2) { left: 5%; top: 4.5rem; z-index: 2; }
    :is([data-journey-ready], [data-journey-complete]) .journey-step:nth-child(3) { left: 10%; top: 9rem; z-index: 3; }
    :is([data-journey-ready], [data-journey-complete]) .journey-action { margin-top: auto; }
    .care-journey[data-journey-complete] { height: auto; }
    [data-journey-complete] .journey-panel { position: relative; top: 0; }
    [data-journey-complete] .journey-step:nth-child(1) { transform: rotate(-3deg); }
    [data-journey-complete] .journey-step:nth-child(2) { transform: rotate(2deg); }
    [data-journey-complete] .journey-step:nth-child(3) { transform: rotate(-1deg); }
  }
  @media (prefers-reduced-motion: no-preference) and (min-height: 800px) and (min-width: 64rem) {
    :is([data-journey-ready], [data-journey-complete]) .journey-stage { max-width: 72rem; }
    :is([data-journey-ready], [data-journey-complete]) .journey-step { width: 36%; height: 17rem; }
    :is([data-journey-ready], [data-journey-complete]) .journey-step:nth-child(1) { left: 0; top: 24%; }
    :is([data-journey-ready], [data-journey-complete]) .journey-step:nth-child(2) { left: 32%; top: 2%; }
    :is([data-journey-ready], [data-journey-complete]) .journey-step:nth-child(3) { left: 64%; top: 32%; }
    [data-journey-complete] .journey-step:nth-child(1) { transform: rotate(-6deg); }
    [data-journey-complete] .journey-step:nth-child(2) { transform: rotate(4deg); }
    [data-journey-complete] .journey-step:nth-child(3) { transform: rotate(-3deg); }
  }
</style>

<script>
  import { animationConfig } from "../../config/animation.config";
  import { initMotion } from "../../scripts/motion";

  document.querySelectorAll<HTMLElement>("[data-care-journey]").forEach((section) => {
    // Mémoire limitée à cette page : ni retour au scroll ni changement de taille ne rejouent la séquence.
    let completed = false;
    initMotion(`care-journey-${section.id}`, ({ gsap, ScrollTrigger, select }) => {
      if (completed) return;
      const panel = section.querySelector<HTMLElement>("[data-journey-panel]");
      const stage = section.querySelector<HTMLElement>("[data-journey-stage]");
      const action = section.querySelector<HTMLElement>("[data-journey-action]");
      const cards = select<HTMLElement>("[data-journey-step]");
      if (!panel || !stage || !action || cards.length !== 3) return;

      const media = gsap.matchMedia();
      media.add("(min-height: 800px) and (min-width: 375px)", () => {
        if (completed) return;
        section.setAttribute("data-journey-ready", "");
        const compact = () => window.matchMedia("(max-width: 63.999rem)").matches;
        const { entranceDuration, readingPause } = animationConfig.careJourney;
        const lastCardArrival = (cards.length - 1) * (entranceDuration + readingPause) + entranceDuration;
        let completionFrame = 0;
        action.inert = true;
        // Cette animation est temporelle : elle se termine même si le visiteur arrête de scroller.
        const actionReveal = gsap.fromTo(action, { autoAlpha: 0, y: 12 }, {
          autoAlpha: 1,
          y: 0,
          duration: animationConfig.duration.normal,
          ease: "power2.out",
          paused: true,
        });
        // GSAP écrit uniquement les transforms/opacités dynamiques pendant la première lecture.
        const timeline = gsap.timeline({
          scrollTrigger: {
            trigger: section,
            start: "top 16px",
            end: () => `+=${Math.max(1, section.offsetHeight - panel.offsetHeight - 16)}`,
            scrub: true,
            invalidateOnRefresh: true,
          },
        });

        cards.forEach((card, index) => {
          timeline.fromTo(card, {
            x: 0,
            y: () => panel.offsetHeight,
            rotation: index === 0 ? -18 : index === 1 ? 16 : -10,
            opacity: 0,
          }, {
            x: 0,
            y: 0,
            rotation: () => compact() ? [-3, 2, -1][index] : [-6, 4, -3][index],
            opacity: 1,
            duration: entranceDuration,
            ease: "power2.out",
          }, index * (entranceDuration + readingPause));
        });
        timeline.to({}, { duration: readingPause });
        const completeJourney = (immediate = false) => {
          if (completed || (!immediate && timeline.time() < lastCardArrival)) return;
          completed = true;
          // Détacher le scroll sans réinitialiser les cartes ; le CTA finit son fondu tout seul.
          timeline.scrollTrigger?.kill(false, true);
          timeline.pause(lastCardArrival, true);
          action.inert = false;
          if (immediate) {
            actionReveal.progress(1).pause();
            section.setAttribute("data-journey-complete", "");
            ScrollTrigger.refresh();
            return;
          }
          actionReveal.play();
          completionFrame = requestAnimationFrame(() => {
            const panelTop = panel.getBoundingClientRect().top;
            const sectionTop = section.getBoundingClientRect().top + window.scrollY;
            section.setAttribute("data-journey-complete", "");
            // Retirer la piste de scroll en conservant exactement la position visuelle du panneau.
            window.scrollTo({ top: sectionTop - panelTop, behavior: "instant" });
            ScrollTrigger.refresh();
          });
        };
        timeline.eventCallback("onUpdate", completeJourney);
        completeJourney();

        const targetBelowJourney = (url: URL): HTMLElement | null => {
          if (url.origin !== window.location.origin || url.pathname !== window.location.pathname || !url.hash) return null;
          let target: HTMLElement | null;
          try { target = document.getElementById(decodeURIComponent(url.hash.slice(1))); }
          catch { return null; }
          return target && !section.contains(target) && (section.compareDocumentPosition(target) & Node.DOCUMENT_POSITION_FOLLOWING) ? target : null;
        };
        // Une navigation directe doit rejoindre sa cible, sans être interrompue par la réduction de hauteur.
        const handleAnchor = (event: MouseEvent) => {
          if (completed || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a[href]") : null;
          if (!link || link.hasAttribute("download") || (link.target && link.target !== "_self")) return;
          if (targetBelowJourney(new URL(link.href))) completeJourney(true);
        };
        document.addEventListener("click", handleAnchor);
        const initialTarget = targetBelowJourney(new URL(window.location.href));
        if (initialTarget && !completed) {
          completeJourney(true);
          completionFrame = requestAnimationFrame(() => initialTarget.scrollIntoView({ behavior: "instant", block: "start" }));
        }

        return () => {
          cancelAnimationFrame(completionFrame);
          document.removeEventListener("click", handleAnchor);
          if (completed) section.setAttribute("data-journey-complete", "");
          section.removeAttribute("data-journey-ready");
          action.inert = false;
        };
      });

      return () => media.revert();
    }, { scope: section });
  });
</script>
