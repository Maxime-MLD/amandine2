---
import { contactConfig } from "../../config/contact.config";
---

<section class="final-cta" aria-labelledby="final-cta-title">
  <div class="cta-lights" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="relative z-10 text-center">
    <h2 id="final-cta-title" class="font-normal">{contactConfig.banner.title}</h2>
    <a class="btn-primary focus-ring mt-8" href={contactConfig.banner.href}>{contactConfig.banner.label}</a>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-inline: clamp(0.5rem, 3vw, 3rem);
    padding: clamp(3.5rem, 7vw, 6.5rem) clamp(1.5rem, 4vw, 4rem);
    border-radius: var(--radius-xl);
    background: var(--gradient-final-cta);
  }
  h2 { font-size: clamp(2rem, 4.2vw, 3.875rem); letter-spacing: -0.045em; line-height: 1.12; }
  .cta-lights { position: absolute; inset: 0; pointer-events: none; }
  .cta-lights span {
    position: absolute;
    width: clamp(10rem, 24vw, 22rem);
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
    background: var(--color-hero-orb);
    border: 1px solid var(--color-hero-orb-edge);
  }
  .cta-lights span:nth-child(1) { left: -4%; top: -45%; }
  .cta-lights span:nth-child(2) { right: 7%; bottom: -55%; }
  .cta-lights span:nth-child(3) { width: 11rem; right: -3%; top: 5%; opacity: 0.5; }
</style>
