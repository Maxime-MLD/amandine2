---
import { faqItems, faqSection } from "../../data/faq";
import FaqItem from "../ui/FaqItem.astro";
---

<section id="faq" class="faq-section" aria-labelledby="faq-title">
  <header data-reveal="faq">
    <h2 id="faq-title" class="section-title">{faqSection.title}<br />{faqSection.titleSecondLine}</h2>
    <p class="faq-description section-description mt-[var(--space-title-copy)]">
      {faqSection.description}
    </p>
  </header>
  <div class="faq-items min-w-0" data-reveal="faq">
    {faqItems.map((item) => <FaqItem item={item} />)}
  </div>
</section>

<style>
  .faq-section {
    display: grid;
    gap: 2.5rem;
    margin-bottom: var(--section-gap);
    padding-inline: var(--content-axis);
  }
  header { min-width: 0; container-type: inline-size; }
  .faq-description { white-space: nowrap; }
  @media (max-width: 26.8125rem) {
    .faq-description {
      width: calc(100% + var(--content-axis) - 0.5rem);
      font-size: clamp(0.75rem, 3.4vw, var(--font-size-section-copy));
      letter-spacing: -0.025em;
    }
  }
  @media (min-width: 72rem) {
    .faq-section {
      grid-template-columns: minmax(0, var(--content-copy-column)) minmax(0, 1fr);
      gap: clamp(4.5rem, 6vw, 7rem);
    }
    .faq-items {
      width: min(100%, var(--content-main-column));
      justify-self: center;
    }
  }
</style>
