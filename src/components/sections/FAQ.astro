---
import { faqItems, faqSection } from "../../data/faq";
import FaqItem from "../ui/FaqItem.astro";
---

<section id="faq" class="faq-section" aria-labelledby="faq-title">
  <header>
    <h2 id="faq-title" class="font-normal">{faqSection.title}<br />{faqSection.titleSecondLine}</h2>
    <p class="mt-5 max-w-[17rem] text-sm leading-relaxed text-[var(--color-text-secondary)] sm:text-base">
      {faqSection.description}
    </p>
  </header>
  <div class="min-w-0">
    {faqItems.map((item) => <FaqItem item={item} />)}
  </div>
</section>

<style>
  .faq-section {
    display: grid;
    gap: 2.5rem;
    padding: clamp(1rem, 2vw, 2rem) clamp(1.25rem, 6vw, 6rem) clamp(5rem, 10vw, 9rem);
  }
  h2 {
    font-size: clamp(2.5rem, 4.2vw, 3.875rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }
  @media (min-width: 64rem) {
    .faq-section { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr); gap: clamp(3rem, 6vw, 6rem); }
  }
</style>
