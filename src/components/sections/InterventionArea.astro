---
import { interventionArea } from "../../data/interventionArea";
---

<section id="zone-intervention" class="intervention-area" aria-labelledby="intervention-title" data-intervention-area>
  <div class="intervention-layout">
    <div class="intervention-copy" data-reveal="intervention-area">
      <h2 id="intervention-title" class="section-title">
        {interventionArea.title}<br />{interventionArea.titleSecondLine}
      </h2>
      <p class="section-description">{interventionArea.description}</p>
      <p class="intervention-note">{interventionArea.note}</p>
      <a class="btn-primary focus-ring intervention-action" href={interventionArea.cta.href}>
        {interventionArea.cta.label}
      </a>
    </div>

    <div
      class="intervention-visual"
      data-reveal="intervention-area"
      aria-label={`Zone d’intervention autour de ${interventionArea.center.name}`}
    >
      <div class="orbit-rings" aria-hidden="true">
        <span data-orbit-ring></span>
        <span data-orbit-ring></span>
        <span data-orbit-ring></span>
        <span data-orbit-ring></span>
      </div>

      <div class="orbit-dots" aria-hidden="true">
        <span data-orbit-dot></span>
        <span data-orbit-dot></span>
        <span data-orbit-dot></span>
      </div>

      <div class="orbit-center" data-orbit-center>
        <strong>{interventionArea.center.name}</strong>
      </div>

      <ul class="orbit-cities" aria-label="Communes desservies autour de Montagny">
        {interventionArea.cities.map((city) => (
          <li
            class:list={[
              "orbit-city",
              `orbit-city--${city.tone}`,
              `orbit-city--${city.position}`,
              `orbit-city--${city.size}`,
            ]}
            data-orbit-city
          >
            {city.name}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .intervention-area {
    margin-bottom: var(--section-gap);
    padding-inline: var(--content-axis);
  }

  .intervention-layout {
    display: grid;
    align-items: center;
    gap: clamp(3rem, 7vw, 6rem);
  }

  .intervention-copy {
    display: flex;
    width: min(100%, 32rem);
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
  }

  .intervention-copy .section-description {
    margin-top: var(--space-title-copy);
  }

  .intervention-note {
    max-width: var(--text-width-short);
    margin-top: 1.25rem;
    color: var(--color-text-secondary);
    font-size: var(--font-size-small);
    line-height: var(--line-height-body);
  }

  .intervention-action { margin-top: 1.75rem; }

  .intervention-visual {
    position: relative;
    isolation: isolate;
    width: min(100%, 42rem);
    aspect-ratio: 1;
    justify-self: center;
  }

  .orbit-rings,
  .orbit-dots,
  .orbit-cities {
    position: absolute;
    inset: 0;
  }

  .orbit-rings span {
    position: absolute;
    top: 50%;
    left: 50%;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--color-text-secondary) 14%, transparent);
    border-radius: var(--radius-pill);
    transform: translate(-50%, -50%);
  }

  .orbit-rings span:nth-child(1) { width: 36%; }
  .orbit-rings span:nth-child(2) { width: 57%; }
  .orbit-rings span:nth-child(3) { width: 77%; }
  .orbit-rings span:nth-child(4) { width: 96%; }

  .orbit-center {
    position: absolute;
    z-index: 3;
    top: 50%;
    left: 50%;
    display: flex;
    width: clamp(7.25rem, 25%, 10.5rem);
    aspect-ratio: 1;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-journey-lilac) 58%, var(--color-surface));
    border-radius: 46% 54% 50% 50% / 52% 47% 53% 48%;
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--color-blue-soft) 78%, var(--color-surface)),
      color-mix(in srgb, var(--color-journey-lilac) 68%, var(--color-surface))
    );
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .orbit-center strong {
    color: var(--color-text);
    font-size: clamp(0.8125rem, 1.1vw, 1rem);
    font-weight: 500;
    letter-spacing: 0.055em;
    line-height: 1.2;
  }

  .orbit-cities {
    z-index: 2;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .orbit-city {
    position: absolute;
    display: flex;
    width: clamp(4.75rem, 11vw, 7rem);
    aspect-ratio: 1;
    align-items: center;
    justify-content: center;
    padding: 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: color-mix(in srgb, var(--color-text) 82%, var(--color-text-secondary));
    font-size: clamp(0.6875rem, 0.8vw, 0.8125rem);
    line-height: 1.15;
    text-align: center;
    text-wrap: balance;
  }

  .orbit-city--blue { background: color-mix(in srgb, var(--color-blue-soft) 72%, var(--color-surface)); }
  .orbit-city--lilac { background: color-mix(in srgb, var(--color-lilac-soft) 76%, var(--color-surface)); }
  .orbit-city--peach { background: color-mix(in srgb, var(--color-peach-soft) 67%, var(--color-surface)); }
  .orbit-city--rose { background: color-mix(in srgb, var(--color-pink-soft) 66%, var(--color-surface)); }

  .orbit-city--wide { width: clamp(6.25rem, 13vw, 8.25rem); }
  .orbit-city--north-west { top: 8%; left: 18%; }
  .orbit-city--north-east { top: 3%; right: 18%; }
  .orbit-city--east { top: 38%; right: 0; }
  .orbit-city--south { bottom: 0; left: 50%; transform: translateX(-50%); }
  .orbit-city--south-west { bottom: 16%; left: 5%; }

  .orbit-dots span {
    position: absolute;
    z-index: 1;
    width: 0.375rem;
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
    background: var(--color-journey-lilac);
  }

  .orbit-dots span:nth-child(1) { top: 18%; left: 26%; }
  .orbit-dots span:nth-child(2) { top: 47%; right: 12%; width: 0.275rem; background: var(--color-blue-soft); }
  .orbit-dots span:nth-child(3) { bottom: 27%; left: 13%; width: 0.3125rem; background: var(--color-pink-soft); }

  @media (min-width: 72rem) {
    .intervention-layout {
      grid-template-columns: minmax(0, 0.82fr) minmax(32rem, 1fr);
    }
  }

  @media (max-width: 71.999rem) {
    .intervention-copy { justify-self: start; }
    .intervention-visual { max-width: 38rem; }
  }

  @media (max-width: 47.999rem) {
    .intervention-layout { gap: 2.75rem; }
    .intervention-visual { width: 100%; }
    .orbit-city {
      width: clamp(4.5rem, 22vw, 5.5rem);
      padding: 0.5rem;
      font-size: clamp(0.625rem, 2.8vw, 0.75rem);
    }
    .orbit-city--wide { width: clamp(5.375rem, 22.5vw, 5.5rem); }
    .orbit-city--north-west { top: 5%; left: 0; }
    .orbit-city--north-east { top: 3%; right: 0; }
    .orbit-city--east { top: 38%; right: 0; }
    .orbit-city--south { bottom: 0; left: 50%; }
    .orbit-city--south-west { bottom: 13%; left: 0; }
  }

  @media (max-width: 25rem) {
    .orbit-city--east { right: 0; }
  }
</style>
