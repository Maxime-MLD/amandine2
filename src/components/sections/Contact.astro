---
import { contactConfig } from "../../config/contact.config";
import ContactForm from "../forms/ContactForm.astro";
---

<section id="contact" class="contact-section" aria-labelledby="contact-title">
  <div class="contact-lights" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="contact-copy">
    <h2 id="contact-title" class="font-normal">{contactConfig.title}<br />{contactConfig.titleSecondLine}</h2>
    <p class="contact-description text-base leading-relaxed text-[var(--color-text-secondary)]">{contactConfig.description}</p>
    <address class="contact-details not-italic">
      <div class="contact-detail">
        <p class="contact-label">{contactConfig.phoneLabel}</p>
        <a class="contact-phone focus-ring" href={contactConfig.phoneHref}>{contactConfig.phone}</a>
      </div>
      <div class="contact-detail">
        <p class="contact-label">{contactConfig.addressLabel}</p>
        <p class="contact-address">{contactConfig.street}<br />{contactConfig.city}</p>
        <p class="text-sm leading-relaxed text-[var(--color-text-secondary)]">{contactConfig.appointmentNote}</p>
        <a class="focus-ring text-sm underline underline-offset-4" href={contactConfig.directionsHref} target="_blank" rel="noopener noreferrer">{contactConfig.directionsLabel}</a>
      </div>
    </address>
  </div>
  <div class="contact-form-panel min-w-0">
    <h3 class="mb-6 text-2xl font-normal tracking-tight">{contactConfig.formTitle}</h3>
    <ContactForm />
  </div>
</section>

<style>
  .contact-section {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 3rem;
    margin: var(--section-gap) var(--section-inline-margin);
    padding: var(--section-inline-padding) max(0.5rem, calc(var(--content-axis) - var(--section-inline-margin)));
    border-radius: var(--radius-xl);
    background-image: var(--gradient-contact-section);
    scroll-margin-top: 2rem;
  }
  .contact-copy, .contact-form-panel { position: relative; z-index: 1; }
  .contact-copy { display: grid; gap: clamp(1.5rem, 2vw, 2rem); min-width: 0; }
  .contact-description { max-width: 25rem; }
  .contact-details { display: grid; gap: clamp(1.5rem, 2vw, 2rem); }
  .contact-detail { display: grid; justify-items: start; gap: 0.75rem; }
  .contact-label { font-size: clamp(1.0625rem, 1.2vw, 1.25rem); font-weight: 500; color: var(--color-text); opacity: 0.78; line-height: 1.4; }
  .contact-address { font-size: clamp(1rem, 1.1vw, 1.125rem); line-height: 1.6; }
  .contact-copy h2 { font-size: clamp(2.5rem, 4.2vw, 3.875rem); line-height: 1.05; letter-spacing: -0.045em; }
  .contact-phone { font-size: clamp(1.125rem, 1.4vw, 1.375rem); letter-spacing: -0.025em; text-decoration: none; line-height: 1.6; }
  .contact-phone:hover { text-decoration: underline; }
  .contact-form-panel {
    width: 100%;
    max-width: 48rem;
    justify-self: center;
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    padding: clamp(1.5rem, 3vw, 3rem) clamp(1.25rem, 2.5vw, 2.5rem);
  }
  .contact-lights { position: absolute; z-index: 0; inset: 0; overflow: hidden; border-radius: inherit; pointer-events: none; }
  .contact-lights span {
    position: absolute;
    width: clamp(12rem, 26vw, 30rem);
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
    background: var(--color-hero-orb);
    border: 1px solid var(--color-hero-orb-edge);
  }
  .contact-lights span:nth-child(1) { left: -8%; top: -12%; }
  .contact-lights span:nth-child(2) { left: 24%; bottom: -18%; }
  .contact-lights span:nth-child(3) { width: clamp(8rem, 16vw, 18rem); right: -5%; top: 15%; }
  @media (min-width: 64rem) {
    .contact-section {
      grid-template-columns: minmax(0, var(--content-copy-column)) minmax(0, 1fr);
      justify-content: stretch;
      gap: clamp(4.5rem, 6vw, 7rem);
    }
    .contact-copy { align-self: center; }
    .contact-form-panel { justify-self: center; }
  }
</style>
