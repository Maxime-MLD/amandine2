---
import { contactConfig } from "../../config/contact.config";
import ContactForm from "../forms/ContactForm.astro";
---

<section id="contact" class="contact-section" aria-labelledby="contact-title">
  <div class="contact-copy">
    <h2 id="contact-title" class="font-normal">{contactConfig.title}<br />{contactConfig.titleSecondLine}</h2>
    <p class="mt-6 max-w-[22rem] text-base leading-relaxed text-[var(--color-text-secondary)]">{contactConfig.description}</p>
    <address class="mt-10 flex flex-col gap-9 not-italic">
      <div>
        <p class="mb-3 text-sm text-[var(--color-text-secondary)]">{contactConfig.phoneLabel}</p>
        <a class="contact-phone focus-ring" href={contactConfig.phoneHref}>{contactConfig.phone}</a>
      </div>
      <div>
        <p class="mb-3 text-sm text-[var(--color-text-secondary)]">{contactConfig.addressLabel}</p>
        <p class="text-lg leading-relaxed">{contactConfig.street}<br />{contactConfig.city}</p>
        <p class="mt-2 text-sm text-[var(--color-text-secondary)]">{contactConfig.appointmentNote}</p>
        <a class="focus-ring mt-5 inline-block text-sm underline underline-offset-4" href={contactConfig.directionsHref} target="_blank" rel="noopener noreferrer">{contactConfig.directionsLabel}</a>
      </div>
    </address>
  </div>
  <div class="contact-form-panel min-w-0">
    <h3 class="mb-6 text-2xl font-normal tracking-tight">{contactConfig.formTitle}</h3>
    <ContactForm />
  </div>
</section>

<style>
  .contact-section {
    display: grid;
    gap: 3rem;
    margin: clamp(3rem, 6vw, 6rem) clamp(0.5rem, 3vw, 3rem);
    padding: clamp(1.25rem, 4vw, 4rem);
    border-radius: var(--radius-xl);
    background-image: var(--gradient-contact-section);
    scroll-margin-top: 2rem;
  }
  .contact-copy h2 { font-size: clamp(2.5rem, 4.2vw, 3.875rem); line-height: 1.05; letter-spacing: -0.045em; }
  .contact-phone { font-size: clamp(1.5rem, 2.8vw, 2.25rem); letter-spacing: -0.025em; text-decoration: none; }
  .contact-phone:hover { text-decoration: underline; }
  .contact-form-panel { background: var(--color-surface); border-radius: var(--radius-xl); padding: clamp(1.25rem, 2.5vw, 2.5rem); }
  @media (min-width: 64rem) {
    .contact-section { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr); gap: clamp(3rem, 6vw, 6rem); }
    .contact-copy { align-self: center; }
  }
</style>
