---
import { homeConfig } from "../../config/home.config";
import { featuresConfig } from "../../config/features.config";
import { navigationConfig } from "../../config/navigation.config";
import ResponsiveImage from "../ui/ResponsiveImage.astro";

const { hero } = homeConfig;
const { appointment } = navigationConfig;
---

<section
  id="hero"
  class="hero"
  aria-labelledby="hero-title"
  data-hero-motion-enabled={featuresConfig.animations ? "" : undefined}
>
  <div class="hero-orbs" aria-hidden="true">
    <span class="orb orb-top"></span>
    <span class="orb orb-right"></span>
    <span class="orb orb-bottom"></span>
  </div>

  <div class="hero-copy relative z-10 min-w-0">
    <p class="hero-badge inline-flex max-w-full items-center gap-2.5 rounded-[var(--radius-pill)] px-4 py-2.5 text-xs font-normal sm:px-5 sm:text-sm">
      <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7v5l3 2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      {hero.badge}
    </p>

    <h1 id="hero-title" class="hero-heading mt-7 font-normal sm:mt-9">
      {hero.titleLines.map((line, index) => (
        <Fragment>
          <span class="hero-line-mask block overflow-hidden">
            <span class="hero-line block">{line}</span>
          </span>
          {index < hero.titleLines.length - 1 ? " " : ""}
        </Fragment>
      ))}
    </h1>

    <p class="hero-description mt-6 max-w-[25rem] text-sm leading-[1.6] text-[var(--color-text-secondary)] sm:mt-7 sm:text-[0.9375rem]">
      {hero.description}
    </p>

    <a class="btn-primary focus-ring mt-7 min-h-[3.25rem] sm:mt-8" href={appointment.href} aria-label={appointment.ariaLabel}>
      {appointment.label}
    </a>

    <p class="mt-5 flex items-center gap-2 text-xs text-[var(--color-text-secondary)] sm:mt-6">
      <svg class="size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" />
        <circle cx="12" cy="10" r="2.5" />
      </svg>
      {hero.location}
    </p>
  </div>

  <div class="hero-portrait" data-hero-media>
    <ResponsiveImage
      src={hero.image.src}
      alt={hero.image.alt}
      priority
      formats={["webp"]}
      fallbackFormat="webp"
      widths={[360, 540, 720, 960, 1086]}
      sizes="(min-width: 2048px) 952px, (min-width: 1024px) 48vw, (min-width: 480px) 440px, 100vw"
      width={hero.image.src.width}
      height={hero.image.src.height}
      quality={85}
      pictureClass="hero-picture"
      class="h-full! w-full object-contain object-bottom"
    />
  </div>
</section>

<script is:inline>
  (() => {
    const hero = document.getElementById("hero");
    if (
      !hero ||
      !hero.hasAttribute("data-hero-motion-enabled") ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) return;

    hero.setAttribute("data-hero-pending", "");
    window.setTimeout(() => {
      if (!hero.hasAttribute("data-hero-pending")) return;
      hero.removeAttribute("data-hero-pending");
      hero.setAttribute("data-hero-fallback", "");
    }, 1600);
  })();
</script>

<style>
  /* La composition et les cercles restent scoped ; toutes les couleurs sont des tokens. */
  .hero {
    width: 100%;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--gradient-hero);
  }

  .hero-copy {
    padding: clamp(2.5rem, 5vw, 3.5rem) var(--content-axis) 0;
  }

  .hero-badge {
    background: var(--color-hero-badge);
  }

  .hero-heading {
    font-size: clamp(2rem, 6vw, 4.5rem);
    line-height: 1.06;
    letter-spacing: var(--tracking-heading);
    text-wrap: initial;
  }

  .hero-line-mask {
    display: block;
    overflow: hidden;
  }

  .hero-line { display: block; }

  .hero[data-hero-pending] .hero-badge,
  .hero[data-hero-pending] .hero-description,
  .hero[data-hero-pending] .hero-copy .btn-primary,
  .hero[data-hero-pending] .hero-copy > p:last-child,
  .hero[data-hero-pending] .hero-portrait {
    opacity: 0;
    visibility: hidden;
  }

  .hero[data-hero-pending] .hero-badge { transform: translateY(8px); }
  .hero[data-hero-pending] .hero-line { transform: translateY(110%); }
  .hero[data-hero-pending] .hero-description,
  .hero[data-hero-pending] .hero-copy .btn-primary,
  .hero[data-hero-pending] .hero-copy > p:last-child { transform: translateY(12px); }
  .hero[data-hero-pending] .hero-portrait { transform: translateY(15px) scale(0.985); }

  .hero-portrait {
    position: relative;
    z-index: 1;
    width: min(100%, 27.5rem);
    height: clamp(20rem, 90vw, 30rem);
    margin: 2.5rem auto 0;
  }

  .hero-portrait :global(.hero-picture) {
    display: block;
    height: 100%;
  }

  .hero-orbs {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .orb {
    position: absolute;
    display: block;
    aspect-ratio: 1;
    border: 1px solid var(--color-hero-orb-edge);
    border-radius: 50%;
    background: var(--color-hero-orb);
  }

  .orb-top {
    width: 11rem;
    top: 49%;
    left: 28%;
  }

  .orb-right {
    width: 16rem;
    right: -9rem;
    bottom: 6rem;
  }

  .orb-bottom {
    width: 34rem;
    right: -10rem;
    bottom: -23rem;
  }

  @media (max-width: 63.999rem) {
    .hero {
      display: flex;
      height: 100vh;
      height: 100svh;
      flex-direction: column;
    }

    .hero-portrait {
      min-height: 0;
      flex: 1 1 auto;
      margin-top: clamp(1.25rem, 4vh, 2.5rem);
      height: auto;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      display: flex;
      /* Même hauteur de navbar que le header ; le contenu peut grandir sur écran bas. */
      min-height: calc(100dvh - var(--navbar-height) - 2 * var(--frame-space));
      align-items: center;
    }

    .hero-copy {
      width: 59%;
      padding: clamp(2rem, 4dvh, 4rem) 0 clamp(2rem, 4dvh, 4rem) var(--content-axis);
    }

    .hero-heading {
      font-size: clamp(3rem, min(4.35vw, 8dvh), 6rem);
    }

    .hero-portrait {
      position: absolute;
      top: 12%;
      right: 1.5%;
      bottom: 0;
      width: 48%;
      height: auto;
      margin: 0;
    }

    .orb-top {
      width: 14rem;
      top: 7%;
      left: 58%;
    }

    .orb-right {
      width: 15rem;
      right: -4rem;
      bottom: 12%;
    }

    .orb-bottom {
      width: 45rem;
      right: -7rem;
      bottom: -32rem;
    }
  }

  @media (max-width: 47.999rem) {
    .hero[data-hero-pending] .hero-line { transform: translateY(105%); }
    .hero[data-hero-pending] .hero-description,
    .hero[data-hero-pending] .hero-copy .btn-primary,
    .hero[data-hero-pending] .hero-copy > p:last-child { transform: translateY(8px); }
    .hero[data-hero-pending] .hero-portrait { transform: translateY(10px) scale(0.985); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line,
    .hero-badge,
    .hero-description,
    .hero-copy .btn-primary,
    .hero-copy > p:last-child,
    .hero-portrait {
      opacity: 1 !important;
      visibility: visible !important;
      transform: none !important;
    }
  }
</style>
