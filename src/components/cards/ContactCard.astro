---
import { careOverview } from "../../data/careOverview";
const { contact } = careOverview;
---
<article class="contact-card flex min-h-[23rem] min-w-0 flex-col items-start justify-center rounded-[var(--radius-lg)] px-5 py-7 xl:px-6 xl:py-8">
  <h2 class="w-full text-[length:var(--font-size-card-title)] leading-[1.1] font-normal tracking-[-0.04em]">{contact.title}</h2>
  <p class="mt-5 w-full text-sm leading-[1.6] text-[var(--color-text-secondary)]">{contact.text}</p>
  <a href={contact.href} class="btn-primary focus-ring mt-7 min-h-12 px-6" aria-label={contact.ariaLabel}>{contact.label}</a>
</article>
<style>
  .contact-card { background-color: var(--color-surface); background-image: var(--gradient-contact); }
</style>
