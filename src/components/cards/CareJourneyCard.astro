---
import type { CareJourneyStep } from "../../data/careJourney";

interface Props { step: CareJourneyStep }
const { step } = Astro.props;
---

<article class:list={["journey-card", `journey-card--${step.tone}`]} data-journey-card>
  <span class="journey-number" aria-hidden="true">{step.number}</span>
  <h3 class="font-normal">{step.title}</h3>
  <p class="journey-description mt-5">{step.description}</p>
  <p class="journey-detail mt-auto pt-6">{step.detail}</p>
</article>

<style>
  .journey-card {
    --journey-card-progress: 0;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: clamp(15.5rem, 22vw, 17.5rem);
    height: 100%;
    overflow: hidden;
    padding: clamp(1.35rem, 2.2vw, 2rem);
    border: 1px solid var(--journey-card-border);
    border-radius: var(--radius-lg);
    background: var(--journey-inactive);
    box-shadow: none;
    color: var(--color-text);
  }
  .journey-card::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -1px;
    border-radius: inherit;
    background: var(--journey-card-gradient);
    opacity: var(--journey-card-progress);
    pointer-events: none;
  }
  .journey-card--lilac { --journey-card-gradient: var(--journey-gradient-01); }
  .journey-card--peach { --journey-card-gradient: var(--journey-gradient-02); }
  .journey-card--rose { --journey-card-gradient: var(--journey-gradient-03); }
  .journey-number {
    display: block;
    margin-bottom: clamp(2rem, 3vw, 3rem);
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }
  h3 {
    width: 100%;
    max-width: 14rem;
    font-size: clamp(1.25rem, 1.45vw, 1.5rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }
  .journey-description {
    width: 100%;
    max-width: 18rem;
    color: var(--color-text-secondary);
    font-size: clamp(0.75rem, 0.82vw, 0.875rem);
    line-height: 1.55;
  }
  .journey-detail {
    position: relative;
    z-index: 1;
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-card {
      --journey-card-progress: 1;
      box-shadow: var(--journey-card-shadow-active);
    }
  }
</style>
