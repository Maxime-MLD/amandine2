---
import Button from "../components/ui/Button.astro";
import Section from "../components/ui/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page introuvable"
  description="La page demandée est introuvable. Revenez à l’accueil du site d’Amandine Gauthier."
  noindex
  nofollow
  navbarVariant="light"
>
  <Section spacing="lg" aria-labelledby="not-found-title">
    <div class="mx-auto max-w-3xl text-center">
      <SectionHeader
        eyebrow="404"
        title="Cette page est introuvable"
        description="Le contenu que vous recherchez n’existe plus ou a été déplacé."
        level={1}
        headingId="not-found-title"
        align="center"
      />
      <div class="mt-8">
        <Button href="/" variant="primary">Retour à l’accueil</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
