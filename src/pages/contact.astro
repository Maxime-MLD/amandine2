---
import Section from "../components/ui/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Prendre rendez-vous"
  description="Contactez Amandine Gauthier pour organiser vos soins infirmiers à domicile ou au cabinet sur rendez-vous."
  navbarSticky
>
  <Section
    id="prendre-rendez-vous"
    spacing="lg"
    aria-labelledby="contact-page-title"
  >
    <SectionHeader
      eyebrow="Contact"
      title="Organisons vos prochains soins"
      description="À domicile ou au cabinet, prenez contact avec Amandine pour organiser votre prise en charge."
      level={1}
      headingId="contact-page-title"
    />
  </Section>
</BaseLayout>
