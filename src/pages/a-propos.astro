---
import Section from "../components/ui/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="À propos"
  description="Découvrez Amandine Gauthier, infirmière à Montagny, et son accompagnement attentif fondé sur 10 ans d’expérience."
  navbarSticky
>
  <Section id="a-propos" spacing="lg" aria-labelledby="about-page-title">
    <SectionHeader
      eyebrow="À propos"
      title="Amandine Gauthier, infirmière à Montagny"
      description="Infirmière avec 10 ans d’expérience, Amandine vous accompagne avec écoute et attention pour des soins adaptés à vos besoins."
      level={1}
      headingId="about-page-title"
    />
  </Section>
</BaseLayout>
