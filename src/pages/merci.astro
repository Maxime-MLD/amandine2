---
import Button from "../components/ui/Button.astro";
import Section from "../components/ui/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Demande envoyée"
  description="Votre demande de rendez-vous a bien été transmise à Amandine Gauthier."
  noindex
  navbarVariant="light"
>
  <Section spacing="lg" aria-labelledby="thank-you-title">
    <div class="mx-auto max-w-3xl text-center">
      <SectionHeader
        eyebrow="Merci"
        title="Votre demande a bien été envoyée"
        description="Amandine vous recontactera afin d’échanger avec vous et de confirmer votre rendez-vous."
        level={1}
        headingId="thank-you-title"
        align="center"
      />
      <div class="mt-8">
        <Button href="/" variant="primary">Retour à l’accueil</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
