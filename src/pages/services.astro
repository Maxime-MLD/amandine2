---
import Section from "../components/ui/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Soins infirmiers à domicile à Montagny"
  description="Soins infirmiers à domicile à Montagny et dans un rayon d’environ 10 km, ou au cabinet uniquement sur rendez-vous."
  navbarSticky
>
  <Section
    id="soins-infirmiers"
    spacing="lg"
    aria-labelledby="services-page-title"
  >
    <SectionHeader
      eyebrow="Les soins"
      title="Des soins infirmiers adaptés à vos besoins"
      description="Pansements, prises de sang, suivi du diabète, préparation et distribution des piluliers, injections, PRADO cardio, entretien de PICC Line ou de chambre implantable et perfusions. Tous les soins ne sont pas présentés sur le site : contactez-moi pour vérifier ensemble votre prise en charge."
      level={1}
      headingId="services-page-title"
    />
  </Section>
</BaseLayout>
