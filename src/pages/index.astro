---
import Hero from "../components/sections/Hero.astro";
import CareOverview from "../components/sections/CareOverview.astro";
import Editorial from "../components/sections/Editorial.astro";
import About from "../components/sections/About.astro";
import CareJourney from "../components/sections/CareJourney.astro";
import InterventionArea from "../components/sections/InterventionArea.astro";
import FAQ from "../components/sections/FAQ.astro";
import FinalCTA from "../components/sections/FinalCTA.astro";
import Contact from "../components/sections/Contact.astro";
import { homeConfig } from "../config/home.config";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={homeConfig.seo.title}
  description={homeConfig.seo.description}
  navbarVariant="light"
  framed
>
  <Hero />
  <CareOverview />
  <Editorial />
  <About />
  <CareJourney />
  <InterventionArea />
  <FAQ />
  <FinalCTA />
  <Contact />
</BaseLayout>

<script>
  import { initLandingMotion } from "../scripts/landing-motion";

  initLandingMotion();
</script>
